{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>hmcts/.github:renovate-config",
    "local>hmcts/.github//renovate/automerge-all"
  ],
  "labels": [
    "dependencies"
  ],
  "timezone": "Europe/London",
  "automergeSchedule": [
    "after 7am and before 8am every weekday",
    "after 6pm and before 8pm every weekday"
  ],
  "platformAutomerge": false,
  "schedule": [
    "after 7am and before 8am every weekday",
    "after 6pm and before 8pm every weekday"
  ],
  "rebaseWhen": "behind-base-branch",
  "automergeStrategy": "squash",
  "prConcurrentLimit": 5,
  "helmv3": {
    "bumpVersion": "patch"
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\sARG .*?_VERSION=(?<currentValue>.*)\\s"]
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "helmv3"
      ],
      "matchDatasources": [
        "docker"
      ],
      "versioning": "helm",
      "groupName": "Helm chart updates",
      "groupSlug": "helm-charts",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "groupName": "JUnit",
      "groupSlug": "junit",
      "automerge": true,
      "automergeType": "pr",
      "matchPackageNames": [
        "/^org\\.junit\\./",
        "/^org\\.junit:/"
      ]
    },
    {
      "groupName": "Spring",
      "groupSlug": "spring",
      "automerge": true,
      "automergeType": "pr",
      "matchPackageNames": [
        "/^org\\.springframework\\./",
        "/^io\\.spring\\./"
      ]
    },
    {
      "groupName": "Camunda",
      "groupSlug": "camunda",
      "automerge": true,
      "automergeType": "pr",
      "matchPackageNames": [
        "/^org\\.camunda\\./"
      ]
    },
    {
      "groupName": "Log4j",
      "groupSlug": "log4j",
      "automerge": true,
      "automergeType": "pr",
      "matchPackageNames": [
        "/^org\\.apache\\.logging\\.log4j:/"
      ]
    },
    {
      "matchPackageNames": [
        "gradle",
        "/^com\\.github\\.ben-manes\\.versions/",
        "/^org\\.owasp\\.dependencycheck/",
        "/^org\\.sonarqube/",
        "/^io\\.freefair\\./"
      ],
      "groupName": "Gradle build tools",
      "groupSlug": "gradle-build-tools",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "All non-major updates",
      "groupSlug": "all-non-major",
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
