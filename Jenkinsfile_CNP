def uploadDmnDiagrams(String env, String changeID) {
  dir("${WORKSPACE}") {
    tenantId = "civil"
    product = "civil"
    sh """
      eval \$(./bin/variables/load-${env}-environment-variables.sh ${changeID})
      ./bin/pull-latest-civil-shared.sh ${getCivilServiceSharedBranch()}
      ./bin/import-dmn-diagram.sh ${WORKSPACE} ${env} ${tenantId} ${product}
    """
  }
}

withPipeline(type, product, component) {
  pipelineConf = config

  env.PLAYWRIGHT_TEST_RESULTS_DIR = 'playwright-test-results'
  env.PLAYWRIGHT_BOOTSTRAP_TEST_RESULTS_DIR = 'civil-wa-bootstrap'
  env.PLAYWRIGHT_SMOKE_TEST_RESULTS_DIR = 'civil-wa-smoke'
  env.PLAYWRIGHT_WORKERS = 8
  env.PLAYWRIGHT_RETRIES = 1
  env.PLAYWRIGHT_EXUI_RETRIES = 1
  env.PLAYWRIGHT_IDAM_RETRIES = 1
  env.PLAYWRIGHT_TEST_SPEED = 'fast'
  env.PLAYWRIGHT_RUN_ACCESSIBILITY_TESTS = false
  env.PLAYWRIGHT_RUN_CUI_USER_SETUP = true
  env.PLAYWRIGHT_RUN_EXUI_USER_DATA_SETUP = true
  env.PLAYWRIGHT_RUN_CUI_USER_DATA_SETUP = true
  env.PLAYWRIGHT_RUN_DATA_SETUP = true
  env.PLAYWRIGHT_WA_ENABLED = true
  env.PLAYWRIGHT_ZOD_VALIDATION_ENABLED = false
  env.PLAYWRIGHT_UNASSIGN_CASES = true

  onPR {
    env.ENVIRONMENT = "preview"
    loadVaultSecrets(secrets)
    env.NODE_TLS_REJECT_UNAUTHORIZED = "0";
    env.CIVIL_SERVICE_IMAGE = getCivilServiceImage()
    env.PLAYWRIGHT_FUNCTIONAL_TEST_RESULTS_DIR = 'civil-wa-pr'
    env.PLAYWRIGHT_PR_FT_GROUPS = getPlaywrightFunctionalTestsGroups()
    env.SKIP_FUNCTIONAL_TESTS = checkForSkipFunctionalTests(env.BRANCH_NAME)
    env.RUN_ALL_FUNCTIONAL_TESTS = checkForRunAllFunctionalTests(env.BRANCH_NAME)
  }
  onMaster {
    env.ENVIRONMENT = "aat"
    env.PLAYWRIGHT_FUNCTIONAL_TEST_RESULTS_DIR = 'civil-wa-master'
    loadVaultSecrets(secrets)
  }
  onDemo {
    env.ENVIRONMENT = 'demo'
    loadVaultSecrets(secrets)
  }

  onPerftest {
    env.ENVIRONMENT = 'perftest'
    loadVaultSecrets(secrets)
  }

  onIthc {
    env.ENVIRONMENT = 'ithc'
    loadVaultSecrets(secretsIthc)
  }

  afterSuccess('checkout') {
    if (env.ENVIRONMENT in ['ithc', 'demo', 'perftest']) {
      def subscriptions = [
        demo    : env.DEMO_SUBSCRIPTION_NAME ?: 'nonprod',
        perftest: env.PERFTEST_SUBSCRIPTION_NAME ?: 'qa',
        ithc    : env.ITHC_SUBSCRIPTION_NAME ?: 'qa'
      ]

      withSubscription(subscriptions[env.ENVIRONMENT], product, env.ENVIRONMENT) {
        withTeamSecrets(pipelineConf, env.ENVIRONMENT) {
          uploadDmnDiagrams(env.ENVIRONMENT, '')
        }
      }
    }
  }

  syncBranchesWithMaster(branchesToSync)

  before('smoketest:preview') {
    sh '''
      echo "Workspace:"
      pwd

      echo "Git HEAD:"
      git rev-parse HEAD || true

      echo "Branch info:"
      git branch --show-current || true
      git status --short || true

      echo "Top level files:"
      ls -la

      echo "Playwright scripts:"
      find playwright-e2e/scripts -maxdepth 4 -type f -print || true

      echo "Civil WA master PR scripts:"
      ls -la playwright-e2e/scripts/civil-wa-master-pr || true

      echo "Smoke script details:"
      stat playwright-e2e/scripts/civil-wa-master-pr/playwright-run-civil-wa-smoke.sh || true
      head -n 20 playwright-e2e/scripts/civil-wa-master-pr/playwright-run-civil-wa-smoke.sh || true

      echo "Tracked playwright script files:"
      git ls-files | grep '^playwright-e2e/scripts' || true

      echo "Specific smoke script tracked?"
      git ls-files playwright-e2e/scripts/civil-wa-master-pr/playwright-run-civil-wa-smoke.sh || true
    '''

    retry (3) {
    sh """
      eval \$(./bin/variables/load-preview-environment-variables.sh ${CHANGE_ID})
      ./bin/pull-latest-civil-shared.sh ${getCivilServiceSharedBranch()}
      ./bin/shared/add-roles.sh
      ./bin/pull-latest-camunda-files.sh ${getCivilServiceCamundaRef()}
      ./bin/import-dmn-diagram.sh . civil civil preview
      ./bin/pull-latest-civil-ccd-files.sh ${getCivilCcdDefinitionBranch()}
      ./bin/import-ccd-definition.sh "-e *-prod.json,*HNL-nonprod.json,AuthorisationCaseType-shuttered.json"
      ./bin/pull-latest-camunda-wa-files.sh ${waStandaloneBranch}
    """
    }
    env.URL="https://xui-civil-task-configuration-pr-${CHANGE_ID}.preview.platform.hmcts.net"
    env.IDAM_API_URL = "https://idam-api.aat.platform.hmcts.net"
    env.IDAM_TEST_SUPPORT_API_URL = "https://idam-testing-support-api.aat.platform.hmcts.net"
    env.SERVICE_AUTH_PROVIDER_API_BASE_URL = "http://rpe-service-auth-provider-aat.service.core-compute-aat.internal"
    env.CCD_DATA_STORE_URL = "https://ccd-data-store-api-civil-task-configuration-pr-${CHANGE_ID}.preview.platform.hmcts.net"
    env.DM_STORE_URL = "http://dm-store-aat.service.core-compute-aat.internal"
    env.PAYMENT_API_URL = "http://payment-api-aat.service.core-compute-aat.internal"
    env.CIVIL_SERVICE_URL="https://civil-task-configuration-pr-${CHANGE_ID}-civil-service.preview.platform.hmcts.net"
    env.WA_TASK_MGMT_URL="https://wa-task-mng-civil-task-configuration-pr-${CHANGE_ID}.preview.platform.hmcts.net"
    yarnBuilder.yarn('install-dependencies')
    copyPrevPlaywrightLastRunAndTestFilesReport()
  }

  afterAlways('smoketest:preview') {
    archiveArtifacts allowEmptyArchive: true, artifacts: "${env.PLAYWRIGHT_TEST_RESULTS_DIR}/**/*"
    publishPlaywrightSmokeReports()
  }

  before('functionalTest:preview') {
    uploadDmnDiagrams('preview',"${CHANGE_ID}")
  }

  afterAlways('functionalTest:preview') {
    archiveArtifacts allowEmptyArchive: true, artifacts: "${env.PLAYWRIGHT_TEST_RESULTS_DIR}/**/*"
    publishPlaywrightFunctionalReports()
  }

  before('smoketest:aat') {
    sh """
      eval \$(./bin/variables/load-aat-environment-variables.sh)
      ./bin/pull-latest-civil-ccd-files.sh ${getCivilCcdDefinitionBranch()}
    """
    env.URL="https://manage-case.aat.platform.hmcts.net"
    env.IDAM_API_URL = "https://idam-api.aat.platform.hmcts.net"
    env.IDAM_TEST_SUPPORT_API_URL = "https://idam-testing-support-api.aat.platform.hmcts.net"
    env.SERVICE_AUTH_PROVIDER_API_BASE_URL = "http://rpe-service-auth-provider-aat.service.core-compute-aat.internal"
    env.CCD_DATA_STORE_URL = "http://ccd-data-store-api-aat.service.core-compute-aat.internal"
    env.DM_STORE_URL = "http://dm-store-aat.service.core-compute-aat.internal"
    env.CIVIL_SERVICE_URL="http://civil-service-aat.service.core-compute-aat.internal"
    env.PAYMENT_API_URL = "http://payment-api-aat.service.core-compute-aat.internal"
    env.WA_TASK_MGMT_URL="http://wa-task-management-api-aat.service.core-compute-aat.internal"
    yarnBuilder.yarn('install-dependencies')
    copyPrevPlaywrightLastRunAndTestFilesReport()
  }

  afterAlways('smoketest:aat') {
    archiveArtifacts allowEmptyArchive: true, artifacts: "${env.PLAYWRIGHT_TEST_RESULTS_DIR}/**/*"
    publishPlaywrightSmokeReports()
  }

  before('functionalTest:aat') {
    env.NODE_TLS_REJECT_UNAUTHORIZED = "0";
    uploadDmnDiagrams('aat','')
  }

  afterSuccess('buildinfra:prod') {
      withAzureKeyvault(
      azureKeyVaultSecrets: secretsProd['civil-prod'],
      keyVaultURLOverride: 'https://civil-prod.vault.azure.net/'
    ) {
      //Release dmns on to prod
      uploadDmnDiagrams('prod', '')
    }
  }

  afterAlways('functionalTest:aat') {
    archiveArtifacts allowEmptyArchive: true, artifacts: "${env.PLAYWRIGHT_TEST_RESULTS_DIR}/**/*"
    publishPlaywrightFunctionalReports()
  }
}
