void publishAllureReport(String reportDir, String reportName, String historyArchiveDir) {
  publishHTML([
    alwaysLinkToLastBuild: true,
    keepAll: true,
    reportDir: reportDir,
    reportFiles: 'index.html',
    reportName: reportName
  ])
  sh "cp -r ./${reportDir}/history/ ./${historyArchiveDir}"
  archiveArtifacts artifacts: "${historyArchiveDir}/**", fingerprint: true
}

def copyPrevPlaywrightLastRunAndTestFilesReport() {
  def buildFound = false
  def buildNumber = currentBuild.previousBuild ? currentBuild.previousBuild.number : 0
  def minBuildNumber = ((buildNumber - 8) > 0) ? buildNumber - 8 : 0
  def lastRunFilePath = "${env.PLAYWRIGHT_TEST_RESULTS_DIR}/${env.PLAYWRIGHT_FUNCTIONAL_TEST_RESULTS_DIR}/.last-run.json"
  def testFilesReportPath = "${env.PLAYWRIGHT_TEST_RESULTS_DIR}/${env.PLAYWRIGHT_FUNCTIONAL_TEST_RESULTS_DIR}/playwrightTestFilesReport.json"
  while (!buildFound && buildNumber > minBuildNumber) {
    try {
      sh "rm -f ${lastRunFilePath} ${testFilesReportPath}"
      copyArtifacts(
        projectName: env.JOB_NAME,
        selector: specific("${buildNumber}"),
        filter: "${lastRunFilePath},${testFilesReportPath}"
      )
      if (!fileExists(lastRunFilePath) || !fileExists(testFilesReportPath)) {
        throw new Exception("Missing one or more Playwright previous run artifacts from build ${buildNumber}")
      }
      if (!checkHasPlaywrightLastRunStatus(['passed', 'failed'])) {
        throw new Exception(
          "Skipping copied .last-run.json from build ${buildNumber} because status was not 'passed' or 'failed'"
        )
      }
      buildFound = true
    } catch (Exception error) {
      echo "Previous Playwright artifacts not usable from build ${buildNumber}: " + error.toString()
      buildNumber--
    }
  }
  return buildFound
}

def checkHasPlaywrightLastRunStatus(expectedStatuses) {
  def lastRunStatus = sh(
    script: "jq -r '.status // empty' ${env.PLAYWRIGHT_TEST_RESULTS_DIR}/${env.PLAYWRIGHT_FUNCTIONAL_TEST_RESULTS_DIR}/.last-run.json",
    returnStdout: true
  ).trim()
  def statuses = expectedStatuses instanceof Collection ? expectedStatuses : [expectedStatuses]
  return statuses.contains(lastRunStatus)
}

def publishPlaywrightSmokeReports() {
  def playwrightTestsFlags = "${env.PLAYWRIGHT_TEST_RESULTS_DIR}/playwrightTestsFlags.properties"

  if (fileExists(playwrightTestsFlags)) {
    def reportFlags = readProperties file: playwrightTestsFlags

    if(!(reportFlags.PLAYWRIGHT_TESTS_SKIPPED == 'true')) {

      if (reportFlags.PLAYWRIGHT_SETUP_TESTS_FAILED == 'true') {
        copyPreviousAllureHistory('playwright-allure-bootstrap-history', 'playwright-allure-bootstrap-results');
        sh 'cp playwright-categories.json playwright-allure-bootstrap-results/categories.json'
        sh "npx allure generate playwright-allure-bootstrap-results --clean -o playwright-allure-bootstrap-report"
        publishAllureReport(
          'playwright-allure-bootstrap-report',
          'Playwright Allure Bootstrap Report',
          'playwright-allure-bootstrap-history'
        )
      }

      if (reportFlags.PLAYWRIGHT_SMOKE_TESTS_FAILED == 'true') {
        copyPreviousAllureHistory('playwright-allure-functional-history', 'playwright-allure-functional-results');
        sh 'cp playwright-categories.json playwright-allure-functional-results/categories.json'
        sh "npx allure generate playwright-allure-functional-results --clean -o playwright-allure-functional-report"
        publishAllureReport(
          'playwright-allure-functional-report',
          'Playwright Allure Functional Report',
          'playwright-allure-functional-history'
        )
      }
    }
  }
}

def publishPlaywrightFunctionalReports() {
  def playwrightTestsFlags = "${env.PLAYWRIGHT_TEST_RESULTS_DIR}/playwrightTestsFlags.properties"

  if (fileExists(playwrightTestsFlags)) {
    def reportFlags = readProperties file: playwrightTestsFlags

    if(!(reportFlags.PLAYWRIGHT_TESTS_SKIPPED == 'true')) {

      copyPreviousAllureHistory('playwright-allure-functional-history', 'playwright-allure-functional-results');
      sh 'cp playwright-categories.json playwright-allure-functional-results/categories.json'
      sh "npx allure generate playwright-allure-functional-results --clean -o playwright-allure-functional-report"
      publishAllureReport(
        'playwright-allure-functional-report',
        'Playwright Allure Functional Report',
        'playwright-allure-functional-history'
      )

      copyPreviousAllureHistory('playwright-allure-bootstrap-history', 'playwright-allure-bootstrap-results');
      sh 'cp playwright-categories.json playwright-allure-bootstrap-results/categories.json'
      sh "npx allure generate playwright-allure-bootstrap-results --clean -o playwright-allure-bootstrap-report"
      publishAllureReport(
        'playwright-allure-bootstrap-report',
        'Playwright Allure Bootstrap Report',
        'playwright-allure-bootstrap-history'
      )
    }
  }
}

def copyPreviousAllureHistory(historyDir, resultsDir) {
  def buildFound = false
  def buildNumber = currentBuild.previousBuild ? currentBuild.previousBuild.number : 0
  def minBuildNumber = ((buildNumber - 8) > 0) ? buildNumber - 8 : 0

  while (!buildFound && buildNumber > minBuildNumber) {
    try {
      copyArtifacts(
        projectName: env.JOB_NAME,
        selector: specific("${buildNumber}"),
        filter: "**/${historyDir}/**",
        target: resultsDir
      )
      sh "mv ${resultsDir}/${historyDir} ${resultsDir}/history"
      buildFound = true
    } catch (Exception error) {
      echo "artifact not found: " + error.toString()
      buildNumber--
    }
  }
}


def getPlaywrightFunctionalTestsGroups() {
  def githubApi = new GithubAPI(this)
  def functionalTestGroups = []
  def labelPrefix = "pr_ft_pw_"
  for (label in githubApi.getLabelsbyPattern(env.BRANCH_NAME, labelPrefix)) {
    functionalTestGroups.add(label.substring(labelPrefix.length()))
  }
  return functionalTestGroups.join(",")
}

def getFunctionalTestsGroups() {
  def githubApi = new GithubAPI(this)
  def functionalTestGroups = []
  for (label in githubApi.getLabelsbyPattern(env.BRANCH_NAME, "pr_ft_")) {
    functionalTestGroups.add(label.substring(6, label.length()))
  }
  return functionalTestGroups.join(",")
}


def getCivilCcdDefinitionBranch() {
  def githubApi = new GithubAPI(this)
  for (label in githubApi.getLabelsbyPattern(env.BRANCH_NAME, "civilDefinitionBranch:")) {
    return label.minus("civilDefinitionBranch:").trim()
  }
  return "master"
}

def getCivilServiceSharedBranch() {
  def githubApi = new GithubAPI(this)
  for (label in githubApi.getLabelsbyPattern(env.BRANCH_NAME, "civilShared:")) {
    return label.minus("civilShared:").trim()
  }
  return "master"
}

def getCivilServiceImage() {
  def githubApi = new GithubAPI(this)
  for (label in githubApi.getLabelsbyPattern(env.BRANCH_NAME, "civilServicePr:") ) {
    return "pr-" + label.minus("civilServicePr:").trim()
  }
  return "latest"
}

def getCivilServiceCamundaRef() {
  def githubApi = new GithubAPI(this)
  for (label in githubApi.getLabelsbyPattern(env.BRANCH_NAME, "civilServicePr:")) {
    return "pr-" + label.minus("civilServicePr:").trim()
  }
  return "master"
}

def checkForSkipFunctionalTests(branch_name) {
  return new GithubAPI(this)
    .getLabelsbyPattern(branch_name, "pr-values:skip-functional-tests")
    .contains("pr-values:skip-functional-tests")
}

def checkForRunAllFunctionalTests(branch_name) {
  return new GithubAPI(this).getLabelsbyPattern(branch_name, "runAllFunctionalTests").contains("runAllFunctionalTests")
}

